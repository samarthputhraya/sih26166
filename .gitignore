# ---------------------------------------------------------------------------
# Big data lives in Google Drive, never in git. GitHub hard-rejects >100 MB and
# the OHRC ZIPs are ~750 MB. Folders are kept, contents are not.
# ---------------------------------------------------------------------------

# Each person's own path to the shared Drive folder.
# This file is intentionally ignored because every machine has its own path.
data_path.txt

data/raw/*
!data/raw/.gitkeep

data/pairs/*
!data/pairs/.gitkeep

demo_cache/*
!demo_cache/.gitkeep

weights/*
!weights/.gitkeep

# Large / raw data files
*.IMG
*.img
*.tif
*.tiff
*.zip
*.JP2
*.mp4

# Large documents / model files
*.pdf
*.pptx
*.docx
*.ckpt
*.pt
*.pth

# Python
venv/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/

# Generated baseline evaluation outputs
baselines/failure_gallery/*.jpg
evaluation/results_log.csv

# LROC generated outputs
lroc_coverage/
lroc_preview.png
data/lroc_analysis/M124545845LE_preview.png
data/lroc_analysis/M124545845LE_enhanced.png	